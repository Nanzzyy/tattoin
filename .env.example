# Neon: use the pooled connection for the Next.js runtime.
DATABASE_URL="postgresql://USER:PASSWORD@EP-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon: use the direct connection for Prisma migrations, Studio, and seed.
DIRECT_URL="postgresql://USER:PASSWORD@EP-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-long-random-password"
# Set only for an intentional password rotation, then remove it.
RESET_ADMIN_PASSWORD="false"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"

# Cloudflare R2 S3 API credentials. Keep these server-side.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_BUCKET_NAME="tattoin-media"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# Public R2 custom domain or enabled r2.dev URL, without a trailing slash.
R2_PUBLIC_URL="https://media.example.com"
# Optional when using a custom S3-compatible endpoint.
# R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
